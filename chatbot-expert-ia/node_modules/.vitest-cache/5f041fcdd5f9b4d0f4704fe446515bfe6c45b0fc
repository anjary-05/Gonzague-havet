// Stratégies responsives (POO : héritage + polymorphisme).
class ResponsiveStrategy {
	constructor(viewportWidth) {
		this.viewportWidth = viewportWidth;
	}
	isMobile() {
		return this.viewportWidth < 768;
	}
	containerClass() {
		return this.isMobile() ? "layout-mobile" : "layout-desktop";
	}
};
class MobileStrategy extends ResponsiveStrategy {
	isMobile() {
		return true;
	}
	containerClass() {
		return "layout-mobile";
	}
};
class DesktopStrategy extends ResponsiveStrategy {
	isMobile() {
		return false;
	}
	containerClass() {
		return "layout-desktop";
	}
};
function createResponsive(viewportWidth) {
	return viewportWidth < 768 ? new MobileStrategy(viewportWidth) : new DesktopStrategy(viewportWidth);
}

