// Stratégies responsives : héritage + polymorphisme, sans HTML statique.
class ResponsiveStrategy {
	constructor(viewportWidth = 1024) {
		this.viewportWidth = viewportWidth;
	}
	isMobile() {
		return this.viewportWidth < 768;
	}
	containerClass() {
		return this.isMobile() ? "layout-mobile" : "layout-desktop";
	}
	maxWidth() {
		return this.isMobile() ? "100%" : null;
	}
};
class MobileStrategy extends ResponsiveStrategy {
	isMobile() {
		return true;
	}
};
class DesktopStrategy extends ResponsiveStrategy {
	isMobile() {
		return false;
	}
};
function createResponsive(viewportWidth) {
	return new ResponsiveStrategy(viewportWidth);
}

