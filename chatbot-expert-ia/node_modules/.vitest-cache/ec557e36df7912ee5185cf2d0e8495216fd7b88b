L de référence\n// (charte shadcn.io) et le rend vivant via le SDK Onirtech.\n//\n// Règles respectées : aucun fetch, aucune API inventée, rendu dérivé du contexte,\n// actions uniquement pour écrire (identité, message, pièces jointes, fin, médias).\nimport { useEffect, useMemo, useRef, useState } from \"react\";\nimport { useTemplate } from \"@onirtech/template-sdk/react\";\n\nconst ELEMENT = \"onirtech-template-chatbot-expert-ia\";\n\nconst LIGHT = {\n  bg: \"#f4f3fa\",\n  fg: \"#2a2740\",\n  card: \"#ffffff\",\n  primary: \"#a8a2f4\",\n  primaryFg: \"#ffffff\",\n  secondary: \"#e6e3f8\",\n  secondaryFg: \"#2f2b55\",\n  muted: \"#ecebf5\",\n  mutedFg: \"#7b7894\",\n  accent: \"#dcd9f6\",\n  border: \"#dedcf0\",\n  ring: \"#8b85f0\",\n  ink: \"#1e1b3a\",\n  mist: \"#c9c6ee\",\n  success: \"#22c55e\",\n  whatsapp: \"#10b981\",\n  page: \"#d9d7ee\",\n};\n\nconst DARK = {\n  bg: \"#15132b\",\n  fg: \"#efeefb\",\n  card: \"#1f1c3d\",\n  primary: \"#a8a2f4\",\n  primaryFg: \"#ffffff\",\n  secondary: \"#2c2954\",\n  secondaryFg: \"#e6e3f8\",\n  muted: \"#232047\",\n  mutedFg: \"#a09db9\",\n  accent: \"#34305f\",\n  border: \"#34305f\",\n  ring: \"#8b85f0\",\n  ink: \"#0f0d24\",\n  mist: \"#3a3670\",\n  success: \"#22c55e\",\n  whatsapp: \"#10b981\",\n  page: \"#0c0b1c\",\n};\n\nconst THEME_ALIASES = {\n  background: \"bg\",\n  bg: \"bg\",\n  foreground: \"fg\",\n  fg: \"fg\",\n  card: \"card\",\n  primary: \"primary\",\n  primary_foreground: \"primaryFg\",\n  secondary: \"secondary\",\n  secondary_foreground: \"secondaryFg\",\n  muted: \"muted\",\n  muted_foreground: \"mutedFg\",\n  accent: \"accent\",\n  border: \"border\",\n  ring: \"ring\",\n  ink: \"ink\",\n  mist: \"mist\",\n  success: \"success\",\n  whatsapp: \"whatsapp\",\n  page: \"page\",\n};\n\nconst DEFAULT_CHIPS = [\n  \"Parcours & Vision\",\n  \"Accompagnement PME / ETI\",\n  \"Territoires d’intervention\",\n];\n\nconst DEFAULT_WELCOME =\n  \"Bonjour ! Je suis l’assistant conversationnel IA de Gonzague Havet. Je réponds à vos questions sur ses expertises, ses territoires d’intervention (France, Maroc, Madagascar) ou pour préparer un échange direct avec lui.\";\n\nconst DEFAULT_ACCEPT = \"image/*,audio/*,application/pdf,text/*\";\n\nfunction SparkIcon() {\n  return (\n    <svg viewBox=\"0 0 24 24\" style={{ width: 12, height: 12 }} aria-hidden=\"true\">\n      <path d=\"M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z\" />\n    </svg>\n  );\n}\n\nfunction CloseIcon() {\n  return (\n    <svg viewBox=\"0 0 24 24\" style={{ width: 20, height: 20 }} aria-hidden=\"true\">\n      <path d=\"M18 6 6 18M6 6l12 12\" />\n    </svg>\n  );\n}\n\nfunction WhatsAppIcon() {\n  return (\n    <svg className=\"wa\" viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n      <path d=\"M7.9 20A9 9 0 1 0 4 16.1L2 22Z\" />\n    </svg>\n  );\n}\n\nfunction PhoneIcon() {\n  return (\n    <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n      <path d=\"M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z\" />\n    </svg>\n  );\n}\n\nfunction CalendarIcon() {\n  return (\n    <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n      <rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\" />\n      <path d=\"M16 2v4M8 2v4M3 10h18\" />\n    </svg>\n  );\n}\n\nfunction ChevronIcon() {\n  return (\n    <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n      <path d=\"m9 18 6-6-6-6\" />\n    </svg>\n  );\n}\n\nfunction AttachIcon() {\n  return (\n    <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n      <path d=\"m21.4 11.1-9.2 9.2a6 6 0 0 1-8.5-8.5l9.2-9.2a4 4 0 0 1 5.7 5.7l-9.2 9.2a2 2 0 0 1-2.8-2.8l8.5-8.5\" />\n    </svg>\n  );\n}\n\nfunction MicIcon() {\n  return (\n    <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n      <rect x=\"9\" y=\"2\" width=\"6\" height=\"12\" rx=\"3\" />\n      <path d=\"M19 10v1a7 7 0 0 1-14 0v-1M12 18v4\" />\n    </svg>\n  );\n}\n\nfunction SendIcon() {\n  return (\n    <svg viewBox=\"0 0 24 24\" style={{ width: 20, height: 20 }} aria-hidden=\"true\">\n      <path d=\"m22 2-7 20-4-9-9-4Z\" />\n      <path d=\"M22 2 11 13\" />\n    </svg>\n  );\n}\n\nfunction CheckIcon() {\n  return (\n    <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n      <path d=\"m5 13 4 4L19 7\" />\n    </svg>\n  );\n}\n\nfunction asText(value, fallback) {\n  return typeof value === \"string\" && value !== \"\" ? value : fallback;\n}\n\nfunction asNumber(value, fallback, min, max) {\n  const n = typeof value === \"number\" ? value : Number(value);\n  if (!Number.isFinite(n)) return fallback;\n  return Math.min(max, Math.max(min, n));\n}\n\nfunction isHttpUrl(value) {\n  return typeof value === \"string\" && /^https?:\\/\\//i.test(value);\n}\n\nfunction safeExternalLink(url, actions, label, children, className) {\n  const props = {\n    className,\n    href: url,\n    target: \"_blank\",\n    rel: \"noopener noreferrer\",\n    onClick: (event) => {\n      // L'action SDK est utilisée quand l'hôte la fournit ; le href reste un\n      // repli fonctionnel (aucune requête faite par le template lui-même).\n      if (isHttpUrl(url) && typeof actions?.openMedia === \"function\") {\n        event.preventDefault();\n        actions.openMedia(url);\n      }\n    },\n  };\n  return (\n    <a {...props} aria-label={label}>\n      {children}\n    </a>\n  );\n}\n\n// Protocole d'interface structurée : seuls ces verbes/composants sont reconnus.\n// Tout ce qui n'est pas dans ces listes est rendu comme « non disponible »,\n// jamais exécuté (aucune action arbitraire, aucun code fourni par l'utilisateur).\nconst INTERFACE_MODES = [\n  \"conversation\", \"visuel\", \"media\", \"application\", \"donnees\", \"exploration\", \"voix\",\n];\nconst INTERFACE_ACTIONS = [\"display\", \"present\", \"open\", \"launch\", \"confirm\"];\nconst INTERFACE_COMPONENTS = [\n  \"gallery\", \"media\", \"form\", \"dataTable\", \"chart\", \"resources\", \"actions\", \"app\",\n];\nconst DEFAULT_INTERFACE_LABELS = {\n  conversation: \"Conversation\",\n  visuel: \"Visuel\",\n  media: \"Média\",\n  application: \"Application\",\n  donnees: \"Données\",\n  exploration: \"Exploration\",\n  voix: \"Voix\",\n  confirmer: \"Confirmer\",\n  annuler: \"Annuler\",\n  non_disponible: \"Ressource non disponible dans cette interface\",\n  ouvrir: \"Ouvrir\",\n};\n\nfunction asObject(value) {\n  return value !== null && typeof value === \"object\" && !Array.isArray(value) ? value : {};\n}\n\nfunction normalizeMode(value) {\n  return INTERFACE_MODES.includes(value) ? value : null;\n}\n\nfunction normalizeInstruction(raw) {\n  const source = asObject(raw);\n  const action = asText(source.action, \"\");\n  const component = asText(source.component, \"\");\n  if (!INTERFACE_ACTIONS.includes(action) || !INTERFACE_COMPONENTS.includes(component)) return null;\n  const props = asObject(source.props);\n  const state = asObject(source.state);\n  return {\n    action,\n    component,\n    resource_id: asText(source.resource_id, \"\"),\n    titre: asText(props.titre, \"\"),\n    version: asNumber(props.version, 1, 1, 99),\n    mode: normalizeMode(source.mode ?? state.mode),\n    props,\n    state,\n  };\n}\n\nfunction instructionResources(instruction, resources, message) {\n  const photos = Array.isArray(resources?.media?.photos) ? resources.media.photos : [];\n  const liens = Array.isArray(resources?.media?.liens) ? resources.media.liens : [];\n  const attaches = Array.isArray(message?.medias) ? message.medias : [];\n  const tout = [\n    ...photos.map((item) => ({ ...item, kind: \"photo\" })),\n    ...liens.map((item) => ({ ...item, kind: \"lien\" })),\n    ...attaches.map((item, index) => ({\n      id: item.id || `media-${index}`,\n      libelle: item.libelle || \"\",\n      url: item.url || \"\",\n      kind: item.type === \"photo\" ? \"photo\" : \"lien\",\n    })),\n  ];\n  const cible = instruction.resource_id;\n  if (!cible || cible === \"media\") return tout;\n  if (cible === \"photos\") return tout.filter((item) => item.kind === \"photo\");\n  if (cible === \"liens\") return tout.filter((item) => item.kind === \"lien\");\n  return tout.filter((item) => item.id === cible);\n}\n\n/**\n * Carte générée par une instruction structurée (`action`, `component`,\n * `resource_id`, `props`, `state`). Elle ne rend que des ressources issues du\n * contexte et ne déclenche que les actions du contrat — jamais de code arbitraire.\n */\nfunction InterfaceCard({\n  instruction,\n  message,\n  resources,\n  actions,\n  labels,\n  lib,\n  canData,\n  canModelForm,\n  dataResult,\n  limiteLignes,\n  confirme,\n  onConfirme,\n  onAnnule,\n  depth = 0,\n}) {\n  const alternative = asText(\n    instruction.props.alternative,\n    \"Vous pouvez poursuivre la conversation ou consulter les ressources disponibles.\",\n  );\n  const items = instructionResources(instruction, resources, message);\n  const libelle = asText(instruction.props.libelle, asText(instruction.titre, instruction.component));\n  const ouvrir = (url) => {\n    if (isHttpUrl(url) && typeof actions?.openMedia === \"function\") actions.openMedia(url);\n  };\n\n  if (instruction.action === \"confirm\" && !confirme) {\n    return (\n      <div className=\"instruction-card\" data-onir-region=\"agent\">\n        <p className=\"instruction-texte\">{libelle}</p>\n        <div className=\"confirm-actions\">\n          <button className=\"btn2\" type=\"button\" onClick={() => onConfirme()}>\n            {lib(\"confirmer\", \"Confirmer\")}\n          </button>\n          <button className=\"chip\" type=\"button\" onClick={() => onAnnule()}>\n            {lib(\"annuler\", \"Annuler\")}\n          </button>\n        </div>\n      </div>\n    );\n  }\n\n  if (instruction.action === \"confirm\" && confirme && depth < 2) {\n    const suite = normalizeInstruction(instruction.props.instruction);\n    if (suite) {\n