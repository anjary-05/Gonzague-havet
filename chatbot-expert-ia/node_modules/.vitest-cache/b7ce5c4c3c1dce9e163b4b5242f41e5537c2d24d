// Polymorphisme des surfaces page / widget (ADR-0040).
class Surface {
	constructor(name) {
		this.name = name === "widget" ? "widget" : "page";
	}
	isWidget() {
		return this.name === "widget";
	}
	isPage() {
		return this.name === "page";
	}
	showPageBackground() {
		return false;
	}
	containerClass() {
		return `surface-${this.name}`;
	}
};
