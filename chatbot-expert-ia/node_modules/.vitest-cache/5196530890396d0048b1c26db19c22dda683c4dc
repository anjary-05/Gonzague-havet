,kDAAC,QAAD;KAAM,WAAU;KAAW,IAAG;KAAO,UAAU;KAAe,oBAAiB;eAA/E;MACE,kDAAC,SAAD;OACE,MAAK;OACL,IAAG;OACO;OACF;OACR;OACA,KAAK;OACL,WAAW,UAAU;QACnB,KAAK,SAAS,MAAM,OAAO,KAAK;QAChC,MAAM,OAAO,QAAQ;OACvB;MACD;;;;;MACA,aACC,kDAAC,UAAD;OACE,WAAU;OACV,IAAG;OACH,MAAK;OACL,cAAW;OACX,eAAe,QAAQ,SAAS,MAAM;iBAEtC,qDAAC,mCAAD,CAAa;;;;;MACP;;;;iBACN;MACJ,kDAAC,SAAD;OAAO,MAAK;OAAO,IAAG;OAAQ,QAAO;OAAU,SAAQ;OAAO;OAAO,KAAK;OAAU,WAAW,UAAU;QACvG,KAAK,SAAS,MAAM,OAAO,KAAK;QAChC,MAAM,OAAO,QAAQ;OACvB;MAAI;;;;;MACH,gBACC,kDAAC,UAAD;OACE,WAAU;OACV,IAAG;OACH,MAAK;OACL,cAAW;OACX,eAAe,SAAS,SAAS,MAAM;iBAEvC,qDAAC,gCAAD,CAAU;;;;;MACJ;;;;iBACN;MACJ,kDAAC,SAAD;OACE,IAAG;OACH,OAAO;OACP,WAAW,UAAU,SAAS,MAAM,OAAO,KAAK;OACnC;OACb,cAAW;OACX,cAAa;OACb,UAAU;MACX;;;;;MACD,kDAAC,UAAD;OACE,WAAU;OACV,IAAG;OACH,MAAK;OACL,cAAW;OACX,UAAU,UAAU,mBAAoB,MAAM,KAAK,MAAM,MAAM,QAAQ,WAAW;iBAElF,qDAAC,iCAAD,CAAW;;;;;MACL;;;;;KACJ;;;;;;IAEL,SAAS,SAAS,KAAK,CAAC,mBAAmB,UAC1C,kDAAC,UAAD;KACE,WAAU;KACV,MAAK;KACL,oBAAiB;KACjB,eAAe,OAAO,SAAS,WAAW,cAAc,QAAQ,OAAO;eAJzE,CAME,qDAAC,kCAAD,CAAY;;;;eACX,eACK;;;;;eACN;GACJ;;;;WAEG;;;;;aAET,kDAAC,UAAD;GACE,WAAU;GACV,MAAK;GACL,SAAS;GACT,cAAW;GACX,oBAAiB;aAEhB,oCAAU,SAAS,IAAI,kDAAC,OAAD;IAAK,WAAU;IAAa,KAAK;IAAW,KAAI;GAAI;;;;cAAI;EAC1E;;;;;CAEN;;;;;AAEV","names":[],"ignoreList":[],"sources":["Aurora.jsx"],"sourcesContent":["// Interface du chatbot Expert IA — reproduit fidèlement le HTML de référence\r\n// (charte shadcn.io) et le rend vivant via le SDK Onirtech.\r\n//\r\n// Règles respectées : aucun fetch, aucune API inventée, rendu dérivé du contexte,\r\n// actions uniquement pour écrire (identité, message, pièces jointes, fin, médias).\r\nimport { useEffect, useMemo, useRef, useState } from \"react\";\r\nimport { useTemplate } from \"@onirtech/template-sdk/react\";\r\n\r\nimport { LIGHT, DARK, THEME_ALIASES, DEFAULT_CHIPS, DEFAULT_WELCOME, DEFAULT_ACCEPT } from \"./constants.js\";\r\nimport {\r\n  SparkIcon, CloseIcon, WhatsAppIcon, PhoneIcon, CalendarIcon, ChevronIcon,\r\n  AttachIcon, MicIcon, SendIcon, CheckIcon,\r\n} from \"./icons.jsx\";\r\nimport { asText, asNumber, isHttpUrl, safeExternalLink } from \"./utils.jsx\";\r\nimport { TemplateParams } from \"./oop/Params.js\";\r\nimport { createTheme } from \"./oop/Theme.js\";\r\nimport { createSurface } from \"./oop/Surface.js\";\r\nimport { createResponsive } from \"./oop/Responsive.js\";\r\nimport {\r\n  INTERFACE_MODES, INTERFACE_ACTIONS, INTERFACE_COMPONENTS, DEFAULT_INTERFACE_LABELS,\r\n} from \"./interfaceProtocol.js\";\r\n\r\nconst ELEMENT = \"onirtech-template-chatbot-expert-ia\";\r\n\r\n\r\nfunction asObject(value) {\r\n  return value !== null && typeof value === \"object\" && !Array.isArray(value) ? value : {};\r\n}\r\n\r\nfunction normalizeMode(value) {\r\n  return INTERFACE_MODES.includes(value) ? value : null;\r\n}\r\n\r\nfunction normalizeInstruction(raw) {\r\n  const source = asObject(raw);\r\n  const action = asText(source.action, \"\");\r\n  const component = asText(source.component, \"\");\r\n  if (!INTERFACE_ACTIONS.includes(action) || !INTERFACE_COMPONENTS.includes(component)) return null;\r\n  const props = asObject(source.props);\r\n  const state = asObject(source.state);\r\n  return {\r\n    action,\r\n    component,\r\n    resource_id: asText(source.resource_id, \"\"),\r\n    titre: asText(props.titre, \"\"),\r\n    version: asNumber(props.version, 1, 1, 99),\r\n    mode: normalizeMode(source.mode ?? state.mode),\r\n    props,\r\n    state,\r\n  };\r\n}\r\n\r\nfunction instructionResources(instruction, resources, message) {\r\n  const photos = Array.isArray(resources?.media?.photos) ? resources.media.photos : [];\r\n  const liens = Array.isArray(resources?.media?.liens) ? resources.media.liens : [];\r\n  const attaches = Array.isArray(message?.medias) ? message.medias : [];\r\n  const tout = [\r\n    ...photos.map((item) => ({ ...item, kind: \"photo\" })),\r\n    ...liens.map((item) => ({ ...item, kind: \"lien\" })),\r\n    ...attaches.map((item, index) => ({\r\n      id: item.id || `media-${index}`,\r\n      libelle: item.libelle || \"\",\r\n      url: item.url || \"\",\r\n      kind: item.type === \"photo\" ? \"photo\" : \"lien\",\r\n    })),\r\n  ];\r\n  const cible = instruction.resource_id;\r\n  if (!cible || cible === \"media\") return tout;\r\n  if (cible === \"photos\") return tout.filter((item) => item.kind === \"photo\");\r\n  if (cible === \"liens\") return tout.filter((item) => item.kind === \"lien\");\r\n  return tout.filter((item) => item.id === cible);\r\n}\r\n\r\n/**\r\n * Carte générée par une instruction structurée (`action`, `component`,\r\n * `resource_id`, `props`, `state`). Elle ne rend que des ressources issues du\r\n * contexte et ne déclenche que les actions du contrat — jamais de code arbitraire.\r\n */\r\nfunction InterfaceCard({\r\n  instruction,\r\n  message,\r\n  resources,\r\n  actions,\r\n  labels,\r\n  lib,\r\n  canData,\r\n  canModelForm,\r\n  dataResult,\r\n  limiteLignes,\r\n  confirme,\r\n  onConfirme,\r\n  onAnnule,\r\n  depth = 0,\r\n}) {\r\n  const alternative = asText(\r\n    instruction.props.alternative,\r\n    \"Vous pouvez poursuivre la conversation ou consulter les ressources disponibles.\",\r\n  );\r\n  const items = instructionResources(instruction, resources, message);\r\n  const libelle = asText(instruction.props.libelle, asText(instruction.titre, instruction.component));\r\n  const ouvrir = (url) => {\r\n    if (isHttpUrl(url) && typeof actions?.openMedia === \"function\") actions.openMedia(url);\r\n  };\r\n\r\n  if (instruction.action === \"confirm\" && !confirme) {\r\n    return (\r\n      <div className=\"instruction-card\" data-onir-region=\"agent\">\r\n        <p className=\"instruction-texte\">{libelle}</p>\r\n        <div className=\"confirm-actions\">\r\n          <button className=\"btn2\" type=\"button\" onClick={() => onConfirme()}>\r\n            {lib(\"confirmer\", \"Confirmer\")}\r\n          </button>\r\n          <button className=\"chip\" type=\"button\" onClick={() => onAnnule()}>\r\n            {lib(\"annuler\", \"Annuler\")}\r\n          </button>\r\n        </div>\r\n      </div>\r\n    );\r\n  }\r\n\r\n  if (instruction.action === \"confirm\" && confirme && depth < 2) {\r\n    const suite = normalizeInstruction(instruction.props.instruction);\r\n    if (suite) {\r\n      return (\r\n        <InterfaceCard\r\n          {...{\r\n            instruction: suite,\r\n            message,\r\n            resources,\r\n            actions,\r\n            labels,\r\n            lib,\r\n            canData,\r\n            canModelForm,\r\n            dataResult,\r\n            limiteLignes,\r\n            confirme: false,\r\n            onConfirme,\r\n            onAnnule,\r\n            depth: depth + 1,\r\n          }}\r\n        />\r\n      );\r\n    }\r\n  }\r\n\r\n  const disponible = (component) => INTERFACE_COMPONENTS.includes(component);\r\n  const modeLabel = lib(instruction.mode || \"conversation\", instruction.mode || \"conversation\");\r\n\r\n  const renduRessources = items.length ? (\r\n    <div className=\"resource-grid\">\r\n      {items.map((item, index) => (\r\n        <button\r\n          className=\"resource-item\"\r\n          type=\"button\"\r\n          key={`${item.id || \"r\"}-${index}`}\r\n          onClick={() => ouvrir(item.url)}\r\n          title={isHttpUrl(item.url) ? lib(\"ouvrir\", \"Ouvrir\") : item.libelle || \"\"}\r\n        >\r\n          {item.kind === \"photo\" && item.url ? <img src={item.url} alt={item.libelle || \"\"} /> : null}\r\n          <span>{item.libelle || item.id || lib(\"ouvrir\", \"Ouvrir\")}</span>\r\n        </button>\r\n      ))}\r\n    </div>\r\n  ) : (\r\n    <p className=\"instruction-texte\">{lib(\"non_disponible\", \"Ressource non disponible dans cette interface\")}. {alternative}</p>\r\n  );\r\n\r\n  let contenu = null;\r\n  if (disponible(instruction.component) && [\"gallery\", \"media\", \"resources\"].includes(instruction.component)) {\r\n    contenu = renduRessources;\r\n  } else if (instruction.component === \"form\") {\r\n    contenu = canModelForm && typeof actions?.openCollectionForm === \"function\" ? (\r\n      <button className=\"btn2\" type=\"button\" onClick={() => actions.openCollectionForm()}>\r\n        {lib(\"ouvrir\", \"Ouvrir\")} · {libelle}\r\n      </button>\r\n    ) : (\r\n      <p className=\"instruction-texte\">\r\n        {lib(\"non_disponible\", \"Ressource non disponible dans cette interface\")}. {alternative}\r\n      </p>\r\n    );\r\n  } else if ([\"dataTable\", \"chart\"].includes(instruction.component)) {\r\n    if (!canData) {\r\n      contenu = <p className=\"instruction-texte\">{lib(\"non_disponible\", \"Ressource non disponible dans cette interface\")}. {alternative}</p>;\r\n    } else if (!dataResult || dataResult.status === \"loading\") {\r\n      contenu = <p className=\"instruction-texte\">Chargement des données…</p>;\r\n    } else if (dataResult.status !== \"ok\") {\r\n      contenu = <p className=\"instruction-texte\">{dataResult.message || \"Données indisponibles\"}. {alternative}</p>;\r\n    } else {\r\n      const colonnes = Array.isArray(dataResult.data?.colonnes) ? dataResult.data.colonnes : [];\r\n      const lignes = (Array.isArray(dataResult.data?.lignes) ? dataResult.data.lignes : []).slice(0, limiteLignes);\r\n      const max = Math.max(1, ...lignes.map((row) => Math.abs(asNumber(row?.valeur, 0, 0, 1e9))));\r\n      contenu = instruction.component === \"chart\" ? (\r\n        <div className=\"chart\">\r\n          {lignes.map((row, index) => (\r\n            <div className=\"chart-row\" key={index}>\r\n              <span>{asText(row?.libelle, `Ligne ${index + 1}`)}</span>\r\n              <div className=\"chart-bar\">\r\n                <i style={{ width: `${Math.round((Math.abs(asNumber(row?.valeur, 0, 0, 1e9)) / max) * 100)}%` }} />\r\n              </div>\r\n              <b>{asText(row?.valeur, \"0\")}</b>\r\n            </div>\r\n          ))}\r\n        </div>\r\n      ) : (\r\n        <table className=\"data-table\">\r\n          <thead>\r\n            <tr>{colonnes.map((colonne, index) => <th key={index}>{asText(colonne, `Colonne ${index + 1}`)}</th>)}</tr>\r\n          </thead>\r\n          <tbody>\r\n            {lignes.map((row, index) => (\r\n              <tr key={index}>\r\n                {colonnes.map((colonne, cell) => (\r\n                  <td key={cell}>{asText(row?.[colonne], \"—\")}</td>\r\n                ))}\r\n              </tr>\r\n            ))}\r\n          </tbody>\r\n        </table>\r\n      );\r\n    }\r\n  } else if (instruction.component === \"actions\") {\r\n    const boutons = Array.isArray(instruction.props.buttons) ? instruction.props.buttons : [];\r\n    contenu = boutons.length ? (\r\n      <div className=\"confirm-actions\">\r\n        {boutons.map((bouton, index) => {\r\n          const commande = asText(bouton?.action, \"\");\r\n          const libelleBouton = asText(bouton?.label, commande);\r\n          if (commande === \"ouvrir_formulaire\" && canModelForm && typeof actions?.openCollectionForm === \"function\") {\r\n            return <button className=\"btn2\" type=\"button\" key={index} onClick={() => actions.openCollectionForm()}>{libelleBouton}</button>;\r\n          }\r\n          if (commande === \"galerie\") {\r\n            return <button className=\"btn2\" type=\"button\" key={index} onClick={() => ouvrir(items[0]?.url)}>{libelleBouton}</button>;\r\n          }\r\n          if (commande === \"terminer\" && typeof actions?.finish === \"function\") {\r\n            return <button className=\"btn2\" type=\"button\" key={index} onClick={() => actions.finish()}>{libelleBouton}</button>;\r\n          }\r\n          return null;\r\n        })}\r\n      </div>\r\n    ) : (\r\n      <p className=\"instruction-texte\">{lib(\"non_disponible\", \"Ressource non disponible dans cette interface\")}. {alternative}</p>\r\n    );\r\n  } else {\r\n    // Jeu, application, voix ou composant inconnu : aucun lanceur n'existe dans\r\n    // le contrat SDK. On l'annonce et on propose les ressources réelles à la place.\r\n    contenu = (\r\n      <>\r\n        <p className=\"instruction-texte\">\r\n          {lib(\"non_disponible\", \"Ressource non disponible dans cette interface\")}. {alternative}\r\n        </p>\r\n        {items.length ? renduRessources : null}\r\n      </>\r\n    );\r\n  }\r\n\r\n  return (\r\n    <div className=\"instruction-card\" data-onir-region=\"agent\">\r\n      <div className=\"instruction-head\">\r\n        <span className=\"instruction-mode\">{modeLabel}</span>\r\n        <strong>{libelle}</strong>\r\n        <small>{instruction.resource_id ? `${instruction.resource_id} · v${instruction.version}` : `v${instruction.version}`}</small>\r\n      </div>\r\n      {contenu}\r\n    </div>\r\n  );\r\n}\r\n\r\nexport function Aurora({ surfaceOverride } = {}) {\r\n  const { ctx, phase, messages, params, capabilities, actions } = useTemplate();\r\n\r\n  const state = ctx?.state ?? { phase: \"identity\", status: \"en_cours\", messages: [], typing: false };\r\n  const resources = ctx?.resources ?? { media: { photos: [], liens: [] }, modelForm: null };\r\n  const consent = ctx?.consent ?? null;\r\n  const surfaceInstance = createSurface(surfaceOverride === \"widget\" || ctx?.surface === \"widget\" ? \"widget\" : \"page\");\r\n  const surface = surfaceInstance.name;\r\n  const statusFinalisee = state.status === \"finalisee\";\r\n  const typing = Boolean(state.typing);\r\n  const canMedia = capabilities.includes(\"media\");\r\n  const canAttachments = capabilities.includes(\"attachments\");\r\n  const canKnowledge = capabilities.includes(\"knowledge\");\r\n  const canUserState = capabilities.includes(\"userState\");\r\n  const canTheme = capabilities.includes(\"theme\");\r\n  const canModelForm = capabilities.includes(\"modelForm\");\r\n  const canFallback = capabilities.includes(\"fallback\");\r\n\r\n  const templateParams = new TemplateParams(params);\r\n  const p = (key, fallback) => templateParams.get(key, fallback);\r\n\r\n  // Lecture d'un token du paramètre structuré `apparence` (ADR-0095).\r\n  const av = (path, fallback) => {\r\n    let node = params?.apparence;\r\n    for (const part of path.split(\".\")) {\r\n      if (node === null || typeof node !== \"object\" || !(part in node)) return fallback;\r\n      node = node[part];\r\n    }\r\n    return node === undefined || node === null ? fallback : node;\r\n  };\r\n  const avText = (path, fallback) => asText(av(path, fallback), fallback);\r\n  const avNum = (path, fallback) => asNumber(av(path, fallback), fallback, -10000, 10000);\r\n  const avBool = (path, fallback) => {\r\n    const value = av(path, fallback);\r\n    return typeof value === \"boolean\" ? value : fallback;\r\n  };\r\n  const visible = (key, path) => p(key, true) !== false && avBool(path, true) !== false;\r\n\r\n  const titre = asText(p(\"titre_chat\"), \"Gonzague Havet (IA)\");\r\n  const initiales = asText(p(\"initiales\"), \"GH\");\r\n  const avatarUrl = asText(p(\"avatar_url\"), \"\");\r\n  const avatarForme = [\"rond\", \"carre\", \"arrondi\"].includes(p(\"avatar_forme\"))\r\n    ? p(\"avatar_forme\")\r\n    : \"rond\";\r\n  const badge = asText(p(\"badge\"), \"IA DIRECTE\");\r\n  const statut = asText(p(\"statut\"), \"Disponible · France · Maroc · Madagascar\");\r\n  const messageAccueil = asText(p(\"message_accueil\"), DEFAULT_WELCOME);\r\n  const libelleWhatsapp = asText(p(\"libelle_whatsapp\"), \"WhatsApp Direct\");\r\n  const urlWhatsapp = asText(p(\"url_whatsapp\"), \"https://wa.me/33632161919\");\r\n  const telephone = asText(p(\"telephone\"), \"+33 3 21 63 19 19\");\r\n  const libelleRdv = asText(p(\"libelle_rdv\"), \"30 min\");\r\n  const libelleRdvBulle = asText(p(\"libelle_rdv_bulle\"), \"Réserver 30 min\");\r\n  const libelleWhatsappBulle = asText(p(\"libelle_whatsapp_bulle\"), \"WhatsApp direct\");\r\n  const urlRdv = asText(p(\"url_rdv\"), \"https://cal.com/gonzague-havet/30min\");\r\n  const placeholder = asText(p(\"placeholder\"), \"Posez votre question à Gonzague (IA)…\");\r\n  const libelleIdentite = asText(p(\"libelle_identite\"), \"Avant de commencer\");\r\n  const libelleDemarrer = asText(p(\"libelle_demarrer\"), \"Démarrer la discussion\");\r\n  const libelleTerminer = asText(p(\"libelle_terminer\"), \"Terminer la discussion\");\r\n  const texteFinalise = asText(p(\"texte_finalise\"), \"Discussion finalisée\");\r\n  const largeur = asNumber(p(\"largeur_widget\"), 420, 280, 720);\r\n  const hauteur = asNumber(p(\"hauteur_widget\"), 660, 320, 1200);\r\n  const afficherNav = p(\"afficher_nav\") !== false;\r\n  const afficherSujets = p(\"afficher_sujets\") !== false;\r\n  const afficherPJ = p(\"afficher_piece_jointe\") !== false;\r\n  const afficherMicro = p(\"afficher_micro\") !== false;\r\n  const afficherGalerie = p(\"afficher_galerie\") === true;\r\n  const themeMode = [\"auto\", \"light\", \"dark\"].includes(p(\"mode_theme\"))\r\n    ? p(\"mode_theme\")\r\n    : \"auto\";\r\n  const voirAvatar = visible(\"afficher_avatar\", \"avatar.visible\");\r\n  const voirBadge = visible(\"afficher_badge\", \"header.visible_badge\");\r\n  const voirStatut = visible(\"afficher_statut\", \"header.visible_statut\");\r\n  const voirHorodatage = visible(\"afficher_horodatage\", \"message.visible_horodatage\");\r\n  const voirBoutonsAccueil = visible(\"afficher_boutons_accueil\", \"message.visible_boutons\");\r\n  const voirFrappe = visible(\"afficher_frappe\", \"frappe.visible\");\r\n  const voirSources = visible(\"afficher_sources\", \"sources.visible\");\r\n  const voirFin = visible(\"afficher_fin\", \"fin.visible\");\r\n  const voirIcones = p(\"afficher_icones\") !== false;\r\n  const styleIcones = p(\"style_icones\") === \"pleins\" ? \"pleins\" : \"traits\";\r\n\r\n  // Thème : tokens du HTML, surchargés par les paramètres puis par ctx.theme\r\n  // (capacité `theme`). Le mode sombre suit le système quand mode_theme=auto.\r\n  const [systemDark, setSystemDark] = useState(() => {\r\n    if (typeof window === \"undefined\" || !window.matchMedia) return false;\r\n    return window.matchMedia(\"(prefers-color-scheme: dark)\").matches;\r\n  });\r\n\r\n  useEffect(() => {\r\n    if (typeof window === \"undefined\" || !window.matchMedia) return undefined;\r\n    const query = window.matchMedia(\"(prefers-color-scheme: dark)\");\r\n    const onChange = (event) => setSystemDark(Boolean(event.matches));\r\n    if (typeof query.addEventListener === \"function\") {\r\n      query.addEventListener(\"change\", onChange);\r\n      return () => query.removeEventListener(\"change\", onChange);\r\n    }\r\n    query.addListener(onChange);\r\n    return () => query.removeListener(onChange);\r\n  }, []);\r\n\r\n  const dark = themeMode === \"dark\" || (themeMode === \"auto\" && systemDark);\r\n\r\n  const tokenStyle = useMemo(() => {\r\n    // Ordre de priorité : couleurs de base → paramètres simples → apparence\r\n    // structurée → thème de l'hôte (ctx.theme, capacité `theme`).\r\n    const tokens = { ...(dark ? DARK : LIGHT) };\r\n    if (params?.couleur_primaire != null) tokens.primary = p(\"couleur_primaire\");\r\n    if (params?.couleur_fond != null) tokens.bg = p(\"couleur_fond\");\r\n    if (params?.couleur_page != null) tokens.page = p(\"couleur_page\");\r\n    if (params?.couleur_accent != null) tokens.accent = p(\"couleur_accent\");\r\n    if (params?.couleur_bordure != null) tokens.border = p(\"couleur_bordure\");\r\n\r\n    const style = {\r\n      \"--bg\": tokens.bg,\r\n      \"--fg\": tokens.fg,\r\n      \"--card\": tokens.card,\r\n      \"--primary\": tokens.primary,\r\n      \"--primary-fg\": tokens.primaryFg,\r\n      \"--secondary\": tokens.secondary,\r\n      \"--secondary-fg\": tokens.secondaryFg,\r\n      \"--muted\": tokens.muted,\r\n      \"--muted-fg\": tokens.mutedFg,\r\n      \"--accent\": tokens.accent,\r\n      \"--border\": tokens.border,\r\n      \"--ring\": tokens.ring,\r\n      \"--ink\": tokens.i