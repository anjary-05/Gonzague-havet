// Hiérarchie POO pour les surfaces d'affichage (page vs widget).
class Surface {
	constructor(name) {
		this.name = name;
	}
	isWidget() {
		return this.name === "widget";
	}
	isPage() {
		return this.name === "page";
	}
	className() {
		return `app surface-${this.name}`;
	}
};
class PageSurface extends Surface {
	constructor() {
		super("page");
	}
	showPageBackground() {
		return true;
	}
};
class WidgetSurface extends Surface {
	constructor() {
		super("widget");
	}
	showPageBackground() {
		return false;
	}
};
function createSurface(name) {
	return name === "widget" ? new WidgetSurface() : new PageSurface();
}

