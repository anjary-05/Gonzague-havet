0b1c\",\n};\n\nconst THEME_ALIASES = {\n  background: \"bg\",\n  bg: \"bg\",\n  foreground: \"fg\",\n  fg: \"fg\",\n  card: \"card\",\n  primary: \"primary\",\n  primary_foreground: \"primaryFg\",\n  secondary: \"secondary\",\n  secondary_foreground: \"secondaryFg\",\n  muted: \"muted\",\n  muted_foreground: \"mutedFg\",\n  accent: \"accent\",\n  border: \"border\",\n  ring: \"ring\",\n  ink: \"ink\",\n  mist: \"mist\",\n  success: \"success\",\n  whatsapp: \"whatsapp\",\n  page: \"page\",\n};\n\nconst DEFAULT_CHIPS = [\n  \"Parcours & Vision\",\n  \"Accompagnement PME / ETI\",\n  \"Territoires d’intervention\",\n];\n\nconst DEFAULT_WELCOME =\n  \"Bonjour ! Je suis l’assistant conversationnel IA de Gonzague Havet. Je réponds à vos questions sur ses expertises, ses territoires d’intervention (France, Maroc, Madagascar) ou pour préparer un échange direct avec lui.\";\n\nconst DEFAULT_ACCEPT = \"image/*,audio/*,application/pdf,text/*\";\n\nfunction SparkIcon() {\n  return (\n    <svg viewBox=\"0 0 24 24\" style={{ width: 12, height: 12 }} aria-hidden=\"true\">\n      <path d=\"M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z\" />\n    </svg>\n  );\n}\n\nfunction CloseIcon() {\n  return (\n    <svg viewBox=\"0 0 24 24\" style={{ width: 20, height: 20 }} aria-hidden=\"true\">\n      <path d=\"M18 6 6 18M6 6l12 12\" />\n    </svg>\n  );\n}\n\nfunction WhatsAppIcon() {\n  return (\n    <svg className=\"wa\" viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n      <path d=\"M7.9 20A9 9 0 1 0 4 16.1L2 22Z\" />\n    </svg>\n  );\n}\n\nfunction PhoneIcon() {\n  return (\n    <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n      <path d=\"M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z\" />\n    </svg>\n  );\n}\n\nfunction CalendarIcon() {\n  return (\n    <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n      <rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\" />\n      <path d=\"M16 2v4M8 2v4M3 10h18\" />\n    </svg>\n  );\n}\n\nfunction ChevronIcon() {\n  return (\n    <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n      <path d=\"m9 18 6-6-6-6\" />\n    </svg>\n  );\n}\n\nfunction AttachIcon() {\n  return (\n    <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n      <path d=\"m21.4 11.1-9.2 9.2a6 6 0 0 1-8.5-8.5l9.2-9.2a4 4 0 0 1 5.7 5.7l-9.2 9.2a2 2 0 0 1-2.8-2.8l8.5-8.5\" />\n    </svg>\n  );\n}\n\nfunction MicIcon() {\n  return (\n    <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n      <rect x=\"9\" y=\"2\" width=\"6\" height=\"12\" rx=\"3\" />\n      <path d=\"M19 10v1a7 7 0 0 1-14 0v-1M12 18v4\" />\n    </svg>\n  );\n}\n\nfunction SendIcon() {\n  return (\n    <svg viewBox=\"0 0 24 24\" style={{ width: 20, height: 20 }} aria-hidden=\"true\">\n      <path d=\"m22 2-7 20-4-9-9-4Z\" />\n      <path d=\"M22 2 11 13\" />\n    </svg>\n  );\n}\n\nfunction CheckIcon() {\n  return (\n    <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n      <path d=\"m5 13 4 4L19 7\" />\n    </svg>\n  );\n}\n\nfunction asText(value, fallback) {\n  return typeof value === \"string\" && value !== \"\" ? value : fallback;\n}\n\nfunction asNumber(value, fallback, min, max) {\n  const n = typeof value === \"number\" ? value : Number(value);\n  if (!Number.isFinite(n)) return fallback;\n  return Math.min(max, Math.max(min, n));\n}\n\nfunction isHttpUrl(value) {\n  return typeof value === \"string\" && /^https?:\\/\\//i.test(value);\n}\n\nfunction safeExternalLink(url, actions, label, children, className) {\n  const props = {\n    className,\n    href: url,\n    target: \"_blank\",\n    rel: \"noopener noreferrer\",\n    onClick: (event) => {\n      // L'action SDK est utilisée quand l'hôte la fournit ; le href reste un\n      // repli fonctionnel (aucune requête faite par le template lui-même).\n      if (isHttpUrl(url) && typeof actions?.openMedia === \"function\") {\n        event.preventDefault();\n        actions.openMedia(url);\n      }\n    },\n  };\n  return (\n    <a {...props} aria-label={label}>\n      {children}\n    </a>\n  );\n}\n\nexport function Aurora({ surfaceOverride } = {}) {\n  const { ctx, phase, messages, params, capabilities, actions } = useTemplate();\n\n  const state = ctx?.state ?? { phase: \"identity\", status: \"en_cours\", messages: [], typing: false };\n  const resources = ctx?.resources ?? { media: { photos: [], liens: [] }, modelForm: null };\n  const consent = ctx?.consent ?? null;\n  const surface = surfaceOverride === \"widget\" || ctx?.surface === \"widget\" ? \"widget\" : \"page\";\n  const statusFinalisee = state.status === \"finalisee\";\n  const typing = Boolean(state.typing);\n  const canMedia = capabilities.includes(\"media\");\n  const canAttachments = capabilities.includes(\"attachments\");\n  const canKnowledge = capabilities.includes(\"knowledge\");\n  const canUserState = capabilities.includes(\"userState\");\n  const canTheme = capabilities.includes(\"theme\");\n  const canModelForm = capabilities.includes(\"modelForm\");\n  const canFallback = capabilities.includes(\"fallback\");\n\n  const p = (key, fallback) => {\n    const value = params?.[key];\n    return value === undefined || value === null ? fallback : value;\n  };\n\n  const titre = asText(p(\"titre_chat\"), \"Gonzague Havet (IA)\");\n  const initiales = asText(p(\"initiales\"), \"GH\");\n  const badge = asText(p(\"badge\"), \"IA DIRECTE\");\n  const statut = asText(p(\"statut\"), \"Disponible · France · Maroc · Madagascar\");\n  const messageAccueil = asText(p(\"message_accueil\"), DEFAULT_WELCOME);\n  const libelleWhatsapp = asText(p(\"libelle_whatsapp\"), \"WhatsApp Direct\");\n  const urlWhatsapp = asText(p(\"url_whatsapp\"), \"https://wa.me/33632161919\");\n  const telephone = asText(p(\"telephone\"), \"+33 3 21 63 19 19\");\n  const libelleRdv = asText(p(\"libelle_rdv\"), \"30 min\");\n  const libelleRdvBulle = asText(p(\"libelle_rdv_bulle\"), \"Réserver 30 min\");\n  const libelleWhatsappBulle = asText(p(\"libelle_whatsapp_bulle\"), \"WhatsApp direct\");\n  const urlRdv = asText(p(\"url_rdv\"), \"https://cal.com/gonzague-havet/30min\");\n  const placeholder = asText(p(\"placeholder\"), \"Posez votre question à Gonzague (IA)…\");\n  const libelleIdentite = asText(p(\"libelle_identite\"), \"Avant de commencer\");\n  const libelleDemarrer = asText(p(\"libelle_demarrer\"), \"Démarrer la discussion\");\n  const libelleTerminer = asText(p(\"libelle_terminer\"), \"Terminer la discussion\");\n  const texteFinalise = asText(p(\"texte_finalise\"), \"Discussion finalisée\");\n  const largeur = asNumber(p(\"largeur_widget\"), 420, 280, 720);\n  const hauteur = asNumber(p(\"hauteur_widget\"), 660, 320, 1200);\n  const afficherNav = p(\"afficher_nav\") !== false;\n  const afficherSujets = p(\"afficher_sujets\") !== false;\n  const afficherPJ = p(\"afficher_piece_jointe\") !== false;\n  const afficherMicro = p(\"afficher_micro\") !== false;\n  const afficherGalerie = p(\"afficher_galerie\") === true;\n  const themeMode = [\"auto\", \"light\", \"dark\"].includes(p(\"mode_theme\"))\n    ? p(\"mode_theme\")\n    : \"auto\";\n\n  // Thème : tokens du HTML, surchargés par les paramètres puis par ctx.theme\n  // (capacité `theme`). Le mode sombre suit le système quand mode_theme=auto.\n  const [systemDark, setSystemDark] = useState(() => {\n    if (typeof window === \"undefined\" || !window.matchMedia) return false;\n    return window.matchMedia(\"(prefers-color-scheme: dark)\").matches;\n  });\n\n  useEffect(() => {\n    if (typeof window === \"undefined\" || !window.matchMedia) return undefined;\n    const query = window.matchMedia(\"(prefers-color-scheme: dark)\");\n    const onChange = (event) => setSystemDark(Boolean(event.matches));\n    if (typeof query.addEventListener === \"function\") {\n      query.addEventListener(\"change\", onChange);\n      return () => query.removeEventListener(\"change\", onChange);\n    }\n    query.addListener(onChange);\n    return () => query.removeListener(onChange);\n  }, []);\n\n  const dark = themeMode === \"dark\" || (themeMode === \"auto\" && systemDark);\n\n  const tokenStyle = useMemo(() => {\n    const tokens = { ...(dark ? DARK : LIGHT) };\n    tokens.primary = asText(p(\"couleur_primaire\"), tokens.primary);\n    tokens.bg = asText(p(\"couleur_fond\"), tokens.bg);\n    tokens.page = asText(p(\"couleur_page\"), tokens.page);\n    tokens.accent = asText(p(\"couleur_accent\"), tokens.accent);\n    tokens.border = asText(p(\"couleur_bordure\"), tokens.border);\n\n    if (canTheme && ctx?.theme && typeof ctx.theme === \"object\") {\n      for (const [key, value] of Object.entries(ctx.theme)) {\n        const token = THEME_ALIASES[key];\n        if (token && typeof value === \"string\" && value !== \"\") tokens[token] = value;\n      }\n    }\n\n    return {\n      \"--bg\": tokens.bg,\n      \"--fg\": tokens.fg,\n      \"--card\": tokens.card,\n      \"--primary\": tokens.primary,\n      \"--primary-fg\": tokens.primaryFg,\n      \"--secondary\": tokens.secondary,\n      \"--secondary-fg\": tokens.secondaryFg,\n      \"--muted\": tokens.muted,\n      \"--muted-fg\": tokens.mutedFg,\n      \"--accent\": tokens.accent,\n      \"--border\": tokens.border,\n      \"--ring\": tokens.ring,\n      \"--ink\": tokens.ink,\n      \"--mist\": tokens.mist,\n      \"--success\": tokens.success,\n      \"--whatsapp\": tokens.whatsapp,\n      \"--page\": tokens.page,\n      \"--widget-width\": `${asNumber(p(\"largeur_widget\"), 420, 280, 720)}px`,\n      \"--widget-height\": `${asNumber(p(\"hauteur_widget\"), 660, 320, 1200)}px`,\n    };\n    // Les paramètres sont gelés par l'hôte : dépendre de l'identité de `params`\n    // suffit, avec `dark` pour le basculement de palette.\n  }, [params, ctx?.theme, canTheme, dark]);\n\n  const [draft, setDraft] = useState(\"\");\n  const [open, setOpen] = useState(true);\n  const [submitting, setSubmitting] = useState(false);\n  const threadRef = useRef(null);\n  const fileRef = useRef(null);\n  const audioRef = useRef(null);\n\n  const pending = canAttachments ? Array.isArray(state.pendingAttachments) ? state.pendingAttachments : [] : [];\n  const fileField = useMemo(() => {\n    const fields = canModelForm && Array.isArray(resources.modelForm) ? resources.modelForm : [];\n    return fields.find((field) => field?.type === \"file\") ?? null;\n  }, [canModelForm, resources.modelForm]);\n  const accept = fileField?.accept?.join?.(\",\") || DEFAULT_ACCEPT;\n  const multiple = fileField?.maxFiles !== 1;\n\n  const chips = useMemo(() => {\n    const configured = p(\"sujets_suggeres\");\n    const list = Array.isArray(configured) ? configured : DEFAULT_CHIPS;\n    return list\n      .filter((item) => typeof item === \"string\" && item.trim() !== \"\")\n      .slice(0, 8)\n      .map((item) => item.trim());\n  }, [params]);\n\n  const menu =\n    canFallback && state.fallback && Array.isArray(state.fallback.questions)\n      ? state.fallback\n      : null;\n\n  useEffect(() => {\n    if (phase === \"chat\") setSubmitting(false);\n  }, [phase]);\n\n  useEffect(() => {\n    const node = threadRef.current;\n    if (node) node.scrollTop = node.scrollHeight;\n  }, [messages?.length, typing, statusFinalisee]);\n\n  function send(text, attachmentIds = []) {\n    const content = String(text ?? \"\").trim();\n    if (typing || statusFinalisee || (!content && attachmentIds.length === 0)) return;\n    if (typeof actions?.sendMessage !== \"function\") return;\n    actions.sendMessage(content, attachmentIds.length ? attachmentIds : undefined);\n    setDraft(\"\");\n  }\n\n  async function addFiles(list) {\n    if (!list || !list.length || typeof actions?.attachFile !== \"function\") return;\n    const fieldName = fileField?.name || \"piece_jointe\";\n    for (const file of Array.from(list)) {\n      try {\n        await actions.attachFile(fieldName, file);\n      } catch {\n        // L'hôte affiche son propre bandeau d'erreur : on ne duplique pas l'erreur.\n      }\n    }\n  }\n\n  function removeAttachment(id) {\n    if (typeof actions?.removeAttachment === \"function\") void actions.removeAttachment(id);\n  }\n\n  function closeDiscussion() {\n    if (typeof actions?.closeWidget === \"function\") actions.closeWidget();\n    setOpen(false);\n  }\n\n  function openDiscussion() {\n    if (typeof actions?.openWidget === \"function\") {\n      actions.openWidget({ width: largeur, height: hauteur });\n    }\n    setOpen(true);\n  }\n\n  function submitIdentity(event) {\n    event.preventDefault();\n    if (submitting || typeof actions?.submitIdentity !== \"function\") return;\n    const data = new FormData(event.currentTarget);\n    const nom = String(data.get(\"nom\") ?? \"\").trim();\n    const email = String(data.get(\"email\") ?? \"\").trim();\n    if (nom === \"\" || email === \"\") return;\n    setSubmitting(true);\n    actions.submitIdentity({\n      nom,\n      email,\n      consentement: data.get(\"consentement\") === \"on\",\n    });\n  }\n\n  function submitMessage(event) {\n    event.preventDefault();\n    send(draft, pending.map((item) => item.id).filter(Boolean));\n  }\n\n  const shownMessages =\n    Array.isArray(messages) && messages.length > 0\n      ? messages\n      : [\n          {\n            id: \"accueil-local\",\n            role: \"assistant\",\n            content: messageAccueil,\n            medias: [],\n            at: new Date().toISOString(),\n          },\n        ];\n\n  return (\n    <main\n      className=\"app\"\n      data-surface={surface}\n      data-theme={dark ? \"dark\" : \"light\"}\n      data-element={ELEMENT}\n      style={tokenStyle}\n      data-onir-region=\"page\"\n    >\n      {open ? (\n        <section\n          className=\"widget\"\n          style={surface === \"page\" ? { maxWidth: \"100%\" } : undefined}\n          aria-label={`Discussion avec l’assistant de ${titre}`}\n          onPaste={(event) => {\n            const files = event.clipboardData?.files;\n            if (files && files.length) {\n              event.preventDefault();\n              void addFiles(files);\n            }\n          }}\n        >\n          <header data-onir-region=\"header\">\n            <div className=\"avatar\">{initiales}</div>\n            <div className=\"who\">\n              <div className=\"row\">\n                <h2>{titre}</h2>\n                <span className=\"badge\">\n                  <SparkIcon />\n                  {badge}\n                </span>\n              </div>\n              <p className=\"status\">\n                <span className=\"dot\" />\n                {statut}\n              </p>\n            </div>\n            <button className=\"close\" type=\"button\" onClick={closeDiscussion} aria-label=\"Fermer la discussion\">\n              <CloseIcon />\n            </button>\n          </header>\n\n          {phase === \"identity\" ? (\n            <div className=\"identity\" data-onir-region=\"identity\">\n              <div className=\"avatar identity-avatar\">{initiales}</div>\n              <h3>{libelleIdentite}</h3>\n              <p>\n                Indiquez vos coordonnées pour discuter avec l’assistant de {titre}.\n              </p>\n              <form onSubmit={submitIdentity}>\n                <label className=\"field\">\n                  Nom\n                  <input name=\"nom\" type=\"text\" placeholder=\"Votre nom\" aria-label=\"Nom\" required />\n                </label>\n                <label className=\"field\">\n                  Email\n                  <input\n                    name=\"email\"\n                    type=\"email\"\n                    placeholder=\"vous@exemple.fr\"\n                    aria-label=\"Email\"\n                    required\n                  />\n                </label>\n                {consent && typeof consent.texte === \"string\" && consent.texte !== \"\" ? (\n                  <label className=\"check\">\n                    <input name=\"consentement\" type=\"checkbox\" />\n                    <span>\n                      {consent.texte}{\" \"}\n                      {isHttpUrl(consent.lien) ? (\n                        <a href={consent.lien} target=\"_blank\" rel=\"noopener noreferrer\">\n                          (politique de confidentialité)\n                        </a>\n                      ) : null}\n                    </span>\n                  </label>\n                ) : null}\n                <button className=\"primary-btn\" type=\"submit\" disabled={submitting}>\n                  {libelleDemarrer}\n                </button>\n              </form>\n            </div>\n          ) : (\n            <>\n              {afficherNav ? (\n                <nav aria-label=\"Contacter directement\" data-onir-region=\"contact_nav\">\n                  {safeExternalLink(\n                    urlWhatsapp,\n                    actions,\n                    libelleWhatsapp,\n                    <>\n                      <WhatsAppIcon />\n                      {libelleWhatsapp}\n                    </>,\n                    \"contact-link\",\n                  )}\n                  <a className=\"contact-link\" href={`tel:${telephone.replace(/\\s/g, \"\")}`}>\n                    <PhoneIcon />\n                    {telephone}\n                  </a>\n                  {safeExternalLink(\n                    urlRdv,\n                    actions,\n                    libelleRdv,\n                    <>\n                      <CalendarIcon />\n                      {libelleRdv}\n                    </>,\n                    \"contact-link\",\n                  )}\n                </nav>\n              ) : null}\n\n              <ol className=\"thread\" ref={threadRef} aria-live=\"polite\" data-onir-region=\"thread\">\n                {shownMessages.map((message, index) => {\n                  const role = message.role === \"user\" ? \"user\" : \"assistant\";\n                  const medias = Array.isArray(message.medias) ? message.medias : [];\n                  const attachments = Array.isArray(message.attachments) ? message.attachments : [];\n                  const knowledge = canKnowledge && Array.isArray(message.knowledge) ? message.knowledge : [];\n                  const mood = canUserState && message.userState ? message.userState : null;\n                  const hasBody = typeof message.content === \"string\" && message.content !== \"\";\n                  const showActions = role === \"assistant\" && index === 0 && !statusFinalisee;\n\n                  return (\n                    <li className={`msg ${role}`} key={message.id || `m-${index}`}>\n                      {role === \"assistant\" ? <div className=\"avatar\">{initiales}</div> : null}\n                      <div\n                        className=\"bubble\"\n                        title={\n                          mood\n                            ? `${mood.label || \"neutral\"} (${Math.round(Number(mood.confidence || 0) * 100)}%)`\n                            : undefined\n                        }\n                      >\n                        {medias.map((media, mediaIndex) =>\n                          media?.type === \"photo\" ? (\n                            <img\n                              className=\"m-img\"\n                              key={`media-${mediaIndex}`}\n                              src={media.url}\n                              alt={media.libelle || \"\"}\n                            />\n                          ) : (\n                            <button\n                              className=\"m-file\"\n                              type=\"button\"\n                              key={`media-${mediaIndex}`}\n                              onClick={() => {\n                                if (isHttpUrl(media?.url) && typeof actions?.openMedia === \"function\") {\n                                  actions.openMedia(media.url);\n                                }\n                              }}\n                            >\n                              {media.libelle || \"Lien\"}\n                            </button>\n                          ),\n                        )}\n                        {attachments.map((attachment, attachmentIndex) => (\n                          <span className=\"m-file\" key={`att-${attachmentIndex}`}>\n                            {attachment.originalName || attachment.fieldLabel || \"Pièce jointe\"}\n                          </span>\n                        ))}\n                        {hasBody ? <p>{message.content}</p> : null}\n                        {knowledge.length ? (\n                          <div className=\"sources\">\n                            Références : {knowledge.map((item) => item.titre || item.ref).join(\", \")}\n                          </div>\n                        ) : null}\n                        {showActions ? (\n                          <div className=\"actions\">\n                            {safeExternalLink(\n                              urlRdv,\n                              actions,\n                              libelleRdvBulle,\n                              <>\n                                {libelleRdvBulle} <ChevronIcon />\n                              </>,\n                              \"btn2\",\n                            )}\n                            {safeExternalLink(\n                              urlWhatsapp,\n                              actions,\n                              libelleWhatsappBulle,\n                              <>\n                                {libelleWhatsappBulle} <ChevronIcon />\n                              </>,\n                              \"btn2\",\n                            )}\n                          </div>\n                        ) : null}\n                        <time>À l’instant</time>\n                      </div>\n                    </li>\n                  );\n                })}\n\n                {typing ? (\n                  <li className=\"msg assistant\">\n                    <div className=\"avatar\">{initiales}</div>\n                    <div className=\"bubble\">\n                      <p>\n                        <span className=\"typing\">\n                          <i />\n                          <i />\n                          <i />\n                        </span>\n                      </p>\n                    </div>\n                  </li>\n                ) : null}\n\n                {statusFinalisee ? (\n                  <li className=\"msg assistant\">\n                    <div className=\"avatar\">{initiales}</div>\n                    <div className=\"bubble\">\n                      <p>{texteFinalise}</p>\n                    </div>\n                  </li>\n                ) : null}\n              </ol>\n\n              {afficherGalerie && canMedia ? (\n                <div className=\"gallery\" aria-label=\"Médias du chatbot\">\n                  {(Array.isArray(resources.media?.photos) ? resources.media.photos : []).map((photo) => (\n                    <button\n                      className=\"gallery-item\"\n                      type=\"button\"\n                      key={photo.id}\n                      onClick={() => typeof actions?.openMedia === \"function\" && actions.openMedia(photo.url)}\n                    >\n                      <img src={photo.url} alt={photo.libelle || \"\"} />\n                    </button>\n                  ))}\n                  {(Array.isArray(resources.media?.liens) ? resources.media.liens : []).map((lien) => (\n                    <button\n                      className=\"gallery-link\"\n                      type=\"button\"\n                      key={lien.id}\n                      onClick={() => typeof actions?.openMedia === \"function\" && actions.openMedia(lien.url)}\n                    >\n                      {lien.libelle || \"Lien\"}\n                    </button>\n                  ))}\n                </div>\n              ) : null}\n\n              {afficherSujets || menu ? (\n                <div className=\"chips\" role=\"group\" aria-label=\"Sujets suggérés\" data-onir-region=\"suggestions\">\n                  {menu\n                    ? menu.questions.map((question) => (\n                        <button\n                          className=\"chip\"\n                          type=\"button\"\n                          key={question.id}\n                          onClick={() => typeof actions?.selectFallback === \"function\" && actions.selectFallback(question.id)}\n                        >\n                          {question.label}\n                        </button>\n                      ))\n                    : afficherSujets\n                      ? chips.map((chip) => (\n                          <button className=\"chip\" type=\"button\" key={chip} onClick={() => send(chip)}>\n                            {chip}\n                          </button>\n                        ))\n                      : null}\n                </div>\n              ) : null}\n\n              {pending.length ? (\n                <div className=\"tray\" id=\"tray\">\n                  {pending.map((item) => (\n                    <div className=\"att\" key={item.id}>\n                      {typeof item.mime === \"string\" && item.mime.startsWith(\"image/\") && item.url ? (\n                        <img src={item.url} alt=\"\" />\n                      ) : null}\n                      <span>{item.originalName || item.fieldLabel || \"Pièce jointe\"}</span>\n                      <button\n                        type=\"button\"\n                        aria-label={`Retirer ${item.originalName || \"la pièce jointe\"}`}\n                        onClick={() => removeAttachment(item.id)}\n                      >\n                        ×\n                      </button>\n                    </div>\n                  ))}\n                </div>\n              ) : null}\n\n              <form className=\"composer\" id=\"form\" onSubmit={submitMessage} data-onir-region=\"composer\">\n                <input\n                  type=\"file\"\n                  id=\"file\"\n                  multiple={multiple}\n                  accept={accept}\n                  hidden\n                  ref={fileRef}\n                  onChange={(event) => {\n                    void addFiles(event.target.files);\n                    event.target.value = \"\";\n                  }}\n                />\n                {afficherPJ ? (\n                  <button\n                    className=\"icon-btn\"\n                    id=\"attach\"\n                    type=\"button\"\n                    aria-label=\"Joindre une image ou un fichier\"\n                    onClick={() => fileRef.current?.click()}\n                  >\n                    <AttachIcon />\n                  </button>\n                ) : null}\n                <input type=\"file\" id=\"audio\" accept=\"audio/*\" capture=\"user\" hidden ref={audioRef} onChange={(event) => {\n                  void addFiles(event.target.files);\n                  event.target.value = \"\";\n                }} />\n                {afficherMicro ? (\n                  <button\n                    className=\"icon-btn\"\n                    id=\"mic\"\n                    type=\"button\"\n                    aria-label=\"Ajouter un message vocal\"\n                    onClick={() => audioRef.current?.click()}\n                  >\n                    <MicIcon />\n                  </button>\n                ) : null}\n                <input\n                  id=\"input\"\n                  value={draft}\n                  onChange={(event) => setDraft(event.target.value)}\n                  placeholder={placeholder}\n                  aria-label=\"Votre message\"\n                  autoComplete=\"off\"\n                  disabled={statusFinalisee}\n                />\n                <button\n                  className=\"send\"\n                  id=\"send\"\n                  type=\"submit\"\n                  aria-label=\"Envoyer\"\n                  disabled={typing || statusFinalisee || (draft.trim() === \"\" && pending.length === 0)}\n                >\n                  <SendIcon />\n                </button>\n              </form>\n\n              {messages.length > 0 && !statusFinalisee ? (\n                <button\n                  className=\"finish\"\n                  type=\"button\"\n                  onClick={() => typeof actions?.finish === \"function\" && actions.finish()}\n                >\n                  <CheckIcon />\n                  {libelleTerminer}\n                </button>\n              ) : null}\n            </>\n          )}\n        </section>\n      ) : (\n        <button className=\"launcher\" type=\"button\" onClick={openDiscussion} aria-label=\"Ouvrir la discussion\">\n          {initiales}\n        </button>\n      )}\n    </main>\n  );\n}\n"],"file":"/src/Aurora.jsx"}